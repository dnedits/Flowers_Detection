<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient">

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/footerLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="20dp"
                android:fontFamily="@font/gothic"
                android:gravity="center"
                android:text="@string/title_main"
                android:textColor="#0F172A"
                android:textSize="26sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:elevation="4dp"
                android:orientation="vertical"
                android:padding="16dp">

                <ImageView
                    android:id="@+id/imageViewResult"
                    android:layout_width="match_parent"
                    android:layout_height="240dp"
                    android:background="#F8FAFC"
                    android:clipToOutline="true"
                    android:scaleType="fitCenter" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_result_box"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvResultTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/gothic"
                        android:gravity="center"
                        android:text="@string/title_result"
                        android:textColor="#1E293B"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvObjectCount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/gothic"
                        android:gravity="center"
                        android:text="@string/result_objects_count"
                        android:textColor="#166534"
                        android:textSize="14sp"
                        tools:text="Найдено объектов: 0" />

                    <TextView
                        android:id="@+id/tvResult"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/gothic"
                        android:gravity="center"
                        android:text="@string/result_placeholder"
                        android:textColor="#64748B"
                        android:textSize="14sp" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/progressBar"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="12dp"
                    android:visibility="gone" />

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:columnCount="2">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTakePhoto"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="4dp"
                        android:fontFamily="@font/gothic"
                        android:text="@string/button_take_photo"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        app:backgroundTint="@color/button_state_selector"
                        app:cornerRadius="12dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSelectImage"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="4dp"
                        android:fontFamily="@font/gothic"
                        android:text="@string/button_select_image"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        app:backgroundTint="@color/button_state_selector"
                        app:cornerRadius="12dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnUpload"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="4dp"
                        android:fontFamily="@font/gothic"
                        android:text="@string/button_upload"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        app:backgroundTint="@color/button_state_selector"
                        app:cornerRadius="12dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnClear"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="4dp"
                        android:fontFamily="@font/gothic"
                        android:text="@string/button_clear"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        app:backgroundTint="@color/button_state_selector"
                        app:cornerRadius="12dp" />
                </GridLayout>

            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/footerLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingTop="12dp"
        android:paddingBottom="16dp"
        android:background="@android:color/transparent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnWebSite"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_web"
            android:contentDescription="@string/desc_website" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:fontFamily="@font/gothic"
            android:text="@string/footer_copyright"
            android:textColor="#0f172a"
            android:textSize="12sp" />

        <ImageButton
            android:id="@+id/btnTelegram"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_telegram"
            android:contentDescription="@string/desc_telegram" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>